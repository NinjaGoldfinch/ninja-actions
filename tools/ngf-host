#!/usr/bin/env bash
# ngf-host — what's running on this box, and updates or deploys from the box itself.
#
# Usage:
#   ngf-host                          # same as: ngf-host status
#   ngf-host status [project...]      # running vs latest, changes nothing
#   ngf-host update [project...]      # update projects with new commits/releases
#   ngf-host update --force [...]     # rebuild/restart even if nothing changed
#   ngf-host update --dry-run [...]   # show what would happen
#   ngf-host update <project> --version v1.2.3   # deploy: projects only, e.g. to roll back
#   ngf-host update <project> --unverified 'reason'   # prod: deploy a version that has not passed staging
#   ngf-host self-update [ref]        # replace this script with tools/ngf-host at ref (default v1)
#
# Config: ~/.config/ngf-host/projects.conf, one line per project.
#
# Deployed through ninja-deploy (the same /srv releases, health check and
# automatic rollback CI uses; `checksums` defaults to SHA256SUMS):
#   name|deploy:owner/repo|asset-name|service|checksums
#   ninja-monitor|deploy:NinjaGoldfinch/ninja-monitor|ninja-monitor-x86_64-linux.tar.gz|ninja-monitor
#   ninja-lol|deploy:NinjaGoldfinch/ninjagoldfinch-lol|ninjagoldfinch-lol.tar.gz|ninjagoldfinch-lol
#   riot-proxy|deploy:NinjaGoldfinch/riot-proxy|riot-proxy-x86_64-linux.tar.gz|riot-proxy|sha256sums
# `update` downloads the release, checks it, and runs
# `sudo -u deploy ninja-deploy <service>` (has, upload, activate) on this box.
# That skips the GitHub prod approval and the Actions history; from your own
# machine, ngf-deploy <service> deploys through CI instead.
# On a prod host (ENV=prod in /etc/ninja-deploy/env) it keeps the same rule as
# CI: the release tag's commit must carry staging/smoke=success (it passed on
# staging) or prod/deployed=success (it has been live, so a rollback), or the
# deploy is refused. --unverified '<reason>' overrides that for one project and
# writes the reason to the log. Staging hosts deploy anything.
#
# Git-checkout projects (pull, build in place, restart):
#   name|path|branch|systemd-unit|build-command|user
#   ninja-lol|/opt/ninjagoldfinch-lol|main|ninjagoldfinch-lol.service|pnpm install --frozen-lockfile && ORIGIN=https://ninjagoldfinch.lol pnpm build|ninjagoldfinch-lol
# `user` (optional) owns the checkout: git and the build run as that user
# through `sudo -H -u`, so files never end up owned by whoever ran this.
#
# Release-binary projects (download latest GitHub release asset, install, restart):
#   name|gh:owner/repo|asset-name|systemd-unit|install-path
#   riot-proxy|gh:NinjaGoldfinch/riot-proxy|riot-proxy-linux-amd64|riot-proxy.service|/usr/local/bin/riot-proxy
#
# Private repos: put a GitHub token (read-only, Contents scope) in
# ~/.config/ngf-host/github-token (chmod 600). Needs curl + jq.
# Installing to a root-owned path uses: sudo install -m 755 <tmp> <install-path>
# so add a matching NOPASSWD sudoers line (see README/notes).

set -euo pipefail

CONF="${NGF_HOST_CONF:-$HOME/.config/ngf-host/projects.conf}"
TOKEN_FILE="${NGF_HOST_TOKEN:-$HOME/.config/ngf-host/github-token}"
LOG_DIR="${NGF_HOST_LOG:-$HOME/.local/state/ngf-host}"
TMP_DIR="/tmp/ngf-host"
LOCK="/tmp/ngf-host.lock"
NINJA_DEPLOY="${NGF_HOST_NINJA_DEPLOY:-/usr/local/sbin/ninja-deploy}"
DEPLOY_USER="${NGF_HOST_DEPLOY_USER:-deploy}"
ETC="${NGF_HOST_ETC:-/etc/ninja-deploy}"
SRV="${NGF_HOST_SRV:-/srv}"
SELF_REPO="${NGF_HOST_SELF_REPO:-NinjaGoldfinch/ninja-actions}"
STATUS_API="${NGF_HOST_STATUS_API:-https://api.github.com}"   # overridable for testing the prod gate

usage() { sed -n '2,/^$/p' "$0"; }
cmd=status
case "${1:-}" in
  status|update|self-update) cmd=$1; shift ;;
  -h|--help|help) usage; exit 0 ;;
esac
force=0 dry=0 want_version='' unverified=''; only=()
while (( $# )); do
  case "$1" in
    --force)   force=1 ;;
    --dry-run) dry=1 ;;
    --version)
      (( $# >= 2 )) || { echo "--version takes a release tag such as v1.2.3" >&2; exit 2; }
      shift; want_version=$1 ;;
    --unverified)
      if (( $# < 2 )) || [[ -z $2 || $2 == -* ]]; then
        echo "--unverified takes a reason, e.g. --unverified 'hotfix for outage, staging down'" >&2; exit 2
      fi
      shift; unverified=$1 ;;
    -h|--help) usage; exit 0 ;;
    -*)        echo "unknown option $1 (try --help)" >&2; exit 2 ;;
    *)         only+=("$1") ;;
  esac
  shift
done
if [[ $cmd != update ]] && { (( force || dry )) || [[ -n $want_version || -n $unverified ]]; }; then
  echo "--force, --dry-run, --version and --unverified belong to: ngf-host update" >&2; exit 2
fi
if [[ -n $unverified ]] && (( ${#only[@]} != 1 )); then
  echo "--unverified needs exactly one project" >&2; exit 2
fi
if [[ -n $want_version ]]; then
  [[ $want_version =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] \
    || { echo "--version takes a release tag such as v1.2.3" >&2; exit 2; }
  (( ${#only[@]} == 1 )) || { echo "--version needs exactly one project" >&2; exit 2; }
fi

[[ $cmd == self-update || -f "$CONF" ]] || { echo "no config at $CONF" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq is required (sudo apt install -y jq)" >&2; exit 1; }
mkdir -p "$LOG_DIR" "$TMP_DIR"

ts()  { date '+%Y-%m-%d %H:%M:%S'; }
say() { printf '%s [%s] %s\n' "$(ts)" "$1" "$2" | tee -a "$LOG_DIR/ngf-host.log"; }
run() { if (( dry )); then echo "    would run: $*"; else "$@"; fi; }

wanted() {
  (( ${#only[@]} == 0 )) && return 0
  local p; for p in "${only[@]}"; do [[ "$p" == "$1" ]] && return 0; done
  return 1
}

gh_api() {
  local url=$1; local -a hdr=(-H "Accept: application/vnd.github+json")
  [[ -r "$TOKEN_FILE" ]] && hdr+=(-H "Authorization: Bearer $(<"$TOKEN_FILE")")
  curl -fsSL "${hdr[@]}" "$url"
}

# --- self-update -------------------------------------------------------------------
# git's blob hash of a file, which the contents API reports as .sha
blob_sha() { { printf 'blob %d\0' "$(( $(wc -c <"$1") ))"; cat "$1"; } | sha1sum | awk '{print $1}'; }

# Fetch tools/ngf-host at a ref through the contents API, check it against git's
# hash and a syntax check, then swap it in with mv (the running bash keeps the
# old file open, so replacing it mid-run is safe).
self_update() {
  local ref=${1:-v1} self json want tmp commit
  [[ $ref =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "bad ref '$ref'" >&2; return 2; }
  self=$(readlink -f "$0")
  json=$(gh_api "https://api.github.com/repos/$SELF_REPO/contents/tools/ngf-host?ref=$ref") \
    || { echo "could not fetch tools/ngf-host at $ref from $SELF_REPO" >&2; return 1; }
  want=$(jq -r '.sha // empty' <<<"$json")
  [[ -n $want ]] || { echo "unexpected answer from the GitHub API" >&2; return 1; }
  commit=$(gh_api "https://api.github.com/repos/$SELF_REPO/commits/$ref" 2>/dev/null | jq -r '.sha[0:7] // "?"') || commit='?'
  if [[ $(blob_sha "$self") == "$want" ]]; then
    echo "ngf-host is already the $ref version ($commit)"; return 0
  fi
  tmp=$(mktemp "$(dirname "$self")/.ngf-host.XXXXXX")
  # shellcheck disable=SC2064 # expand $tmp now
  trap "rm -f '$tmp'" EXIT
  jq -r .content <<<"$json" | base64 -d >"$tmp"
  [[ $(blob_sha "$tmp") == "$want" ]] || { echo "download does not match git's hash, not installing" >&2; return 1; }
  bash -n "$tmp" || { echo "the $ref version does not parse, not installing" >&2; return 1; }
  chmod 755 "$tmp"
  mv -f "$tmp" "$self"
  trap - EXIT
  echo "updated $self to $ref ($commit)"
}

if [[ $cmd == self-update ]]; then
  (( ${#only[@]} <= 1 )) || { echo "self-update takes one ref" >&2; exit 2; }
  self_update "${only[0]:-}"; exit
fi

# --- status (read-only) ------------------------------------------------------
show() { printf '%-16s %-12s %-12s %s\n' "$@"; }
latest_tag() { gh_api "https://api.github.com/repos/$1/releases/latest" 2>/dev/null | jq -r '.tag_name // "?"' || echo '?'; }

# CI-deployed services: compare what answers the health check, what was last
# deployed (live.json) and the latest release.
status_deploy() {
  local name=$1 repo=${2#deploy:} service=${4:-$1} latest live running state
  latest=$(latest_tag "$repo")
  live=$(jq -r '.version // "?"' "$SRV/$service/live.json" 2>/dev/null || echo none)
  # shellcheck disable=SC1090 # the service's ninja-deploy settings, for HEALTH_URL
  running=$( (. "$ETC/$service.conf" && curl -fsS --max-time 2 "$HEALTH_URL") 2>/dev/null \
             | jq -r '.version // empty' 2>/dev/null || true)
  running=${running:+v${running#v}}
  if [[ -z "$running" ]]; then state="NOT ANSWERING its health check"
  elif [[ "$running" != "$live" ]]; then state="running $running, but the last deploy was $live"
  elif [[ "$live" == "$latest" ]]; then state="up to date"
  else state="behind: ngf-host update $name"
  fi
  show "$name" "${running:-down}" "$latest" "$state"
}

status_release() {
  local name=$1 repo=${2#gh:} latest installed
  latest=$(latest_tag "$repo")
  installed=$(cat "$LOG_DIR/$name.tag" 2>/dev/null || echo unknown)
  if [[ "$installed" == "$latest" ]]; then
    show "$name" "$installed" "$latest" "up to date"
  else
    show "$name" "$installed" "$latest" "behind: ngf-host update $name"
  fi
}

status_git() {
  local name=$1 path=$2 branch=$3 user=${6:-} here there behind
  as_owner() { if [[ -n "$user" ]]; then sudo -H -u "$user" "$@"; else "$@"; fi; }
  if ! as_owner git -C "$path" fetch --quiet origin "$branch" 2>/dev/null; then
    show "$name" "?" "?" "FETCH FAILED${user:+ (as $user)}"; return
  fi
  here=$(as_owner git -C "$path" rev-parse --short HEAD)
  there=$(as_owner git -C "$path" rev-parse --short "origin/$branch")
  behind=$(as_owner git -C "$path" rev-list --count "HEAD..origin/$branch")
  if [[ "$behind" == 0 ]]; then
    show "$name" "$here" "$there" "up to date"
  else
    show "$name" "$here" "$there" "$behind commits behind: ngf-host update $name"
  fi
}

# --- update: shared -----------------------------------------------------------
# restart a unit and verify it came back; prints journal tail on failure
restart_unit() {
  local name=$1 unit=$2
  [[ -z "$unit" ]] && return 0
  say "$name" "restarting $unit"
  run sudo systemctl restart "$unit"
  (( dry )) || sleep 2
  if (( dry )) || systemctl is-active --quiet "$unit"; then
    say "$name" "ok"
  else
    say "$name" "FAILED — $unit is not active, last log lines:"
    journalctl -u "$unit" -n 15 --no-pager | tee -a "$LOG_DIR/ngf-host.log"
    return 1
  fi
}

# --- update: git checkout projects ---------------------------------------------
update_git() {
  local name=$1 path=$2 branch=$3 unit=$4 build=$5 user=${6:-}
  # As the checkout's owner, when the config names one.
  as_owner() { if [[ -n "$user" ]]; then sudo -H -u "$user" "$@"; else "$@"; fi; }
  if [[ ! -d "$path/.git" ]]; then
    say "$name" "no git repo at $path"; return 1
  fi
  cd "$path"
  # Each step checks its own result: set -e is off inside `( … ) || rc=$?`.
  if ! as_owner git -C "$path" fetch --quiet origin "$branch"; then
    say "$name" "FETCH FAILED${user:+ (as $user)}"; return 1
  fi
  local local_rev remote_rev
  local_rev=$(as_owner git -C "$path" rev-parse HEAD) || { say "$name" "git rev-parse failed"; return 1; }
  remote_rev=$(as_owner git -C "$path" rev-parse "origin/$branch") || { say "$name" "git rev-parse failed"; return 1; }

  if [[ "$local_rev" == "$remote_rev" && $force -eq 0 ]]; then
    say "$name" "up to date (${local_rev:0:7})"; return 3
  fi

  say "$name" "updating ${local_rev:0:7} -> ${remote_rev:0:7}"
  if ! run as_owner git -C "$path" checkout --quiet "$branch" ||
     ! run as_owner git -C "$path" pull --ff-only --quiet origin "$branch"; then
    say "$name" "PULL FAILED"; return 1
  fi

  if [[ -n "$build" ]]; then
    say "$name" "building: $build"
    if (( dry )); then echo "    would run: $build"
    elif ! as_owner bash -c "cd \"\$1\" && $build" _ "$path" >>"$LOG_DIR/$name.log" 2>&1; then
      say "$name" "BUILD FAILED — last lines of $LOG_DIR/$name.log:"
      tail -n 20 "$LOG_DIR/$name.log" | tee -a "$LOG_DIR/ngf-host.log"
      return 1
    fi
  fi
  restart_unit "$name" "$unit"
}

# --- update: projects deployed through ninja-deploy ------------------------------
# ninja-deploy reads its command from SSH_ORIGINAL_COMMAND, as under CI's forced key.
ninja_deploy() {
  local service=$1; shift
  sudo -u "$DEPLOY_USER" env SSH_ORIGINAL_COMMAND="$*" "$NINJA_DEPLOY" "$service"
}

# On a prod host, the rule CI's deploy action enforces with require-status: the
# tag's commit needs staging/smoke or prod/deployed at success. A release being
# on disk proves nothing (one that failed its health check stays there too).
# An unreadable status fails closed.
prod_gate() {
  local name=$1 repo=$2 tag=$3 host_env statuses ctx state why
  host_env=$(sed -n 's/^ENV=//p' "$ETC/env" 2>/dev/null)
  [[ $host_env == prod ]] || return 0
  if statuses=$(gh_api "$STATUS_API/repos/$repo/commits/$tag/status"); then
    for ctx in staging/smoke prod/deployed; do
      state=$(jq -r --arg c "$ctx" '[.statuses[]? | select(.context == $c) | .state][0] // empty' <<<"$statuses")
      if [[ $state == success ]]; then
        say "$name" "$tag has $ctx=success"; return 0
      fi
    done
    why="$tag has neither staging/smoke nor prod/deployed at success"
  else
    why="could not read the commit statuses of $tag"
  fi
  if [[ -n $unverified ]]; then
    say "$name" "UNVERIFIED DEPLOY to prod: $why. Reason given: $unverified"
    return 0
  fi
  say "$name" "REFUSED: $why. Deploy it to staging first, or override with --unverified '<reason>'"
  return 1
}

update_deploy() {
  local name=$1 repo=${2#deploy:} asset=$3 service=${4:-$1} sums=${5:-SHA256SUMS}
  if [[ ! -r "$ETC/$service.conf" || ! -x "$NINJA_DEPLOY" ]]; then
    say "$name" "$service is not set up for ninja-deploy here (infra/deploy-host-add.sh)"; return 1
  fi
  local json tag live
  if [[ -n $want_version ]]; then
    json=$(gh_api "https://api.github.com/repos/$repo/releases/tags/$want_version") \
      || { say "$name" "no release $want_version in $repo"; return 1; }
  else
    json=$(gh_api "https://api.github.com/repos/$repo/releases/latest") \
      || { say "$name" "could not fetch the latest release of $repo"; return 1; }
  fi
  tag=$(jq -r .tag_name <<<"$json")
  live=$(jq -r '.version // "none"' "$SRV/$service/live.json" 2>/dev/null || echo none)
  if [[ "$live" == "$tag" && $force -eq 0 ]]; then
    say "$name" "up to date ($tag)"; return 3
  fi

  # The live version is already in production; --force only restarts it.
  if [[ "$tag" != "$live" ]]; then prod_gate "$name" "$repo" "$tag" || return 1; fi
  say "$name" "deploying $tag (live: $live) through ninja-deploy"
  # What `ninja-deploy has` checks, read directly: the directories are
  # world-readable, so this needs no sudo (a dry run never asks for a password),
  # and a sudo or setup problem is reported as itself at upload, not taken for
  # "not on disk".
  if [[ ! -d "$SRV/$service/releases" ]]; then
    say "$name" "$SRV/$service/releases does not exist (infra/deploy-host-add.sh)"; return 1
  fi
  (( dry )) || sudo -v || { say "$name" "sudo failed"; return 1; }
  if [[ -d "$SRV/$service/releases/$tag" ]]; then
    say "$name" "$tag is already on disk, skipping the upload"
  elif (( dry )); then
    echo "    would download $asset and $sums from $tag, check them, and run: ninja-deploy $service upload $tag"
  else
    local url sums_url dir
    url=$(jq -r --arg a "$asset" '.assets[] | select(.name==$a) | .url' <<<"$json")
    sums_url=$(jq -r --arg a "$sums" '.assets[] | select(.name==$a) | .url' <<<"$json")
    if [[ -z "$url" || -z "$sums_url" ]]; then
      say "$name" "release $tag lacks $asset or $sums. Assets: $(jq -r '[.assets[].name]|join(", ")' <<<"$json")"
      return 1
    fi
    dir=$(mktemp -d "$TMP_DIR/$name.XXXXXX")
    # Runs in its own subshell (see main), so EXIT is the end of this project.
    # shellcheck disable=SC2064 # expand $dir now
    trap "rm -rf '$dir'" EXIT
    if ! gh_download "$url" "$dir/$asset" || ! gh_download "$sums_url" "$dir/$sums"; then
      say "$name" "download failed"; return 1
    fi
    if ! (cd "$dir" && sha256sum --ignore-missing --strict --quiet -c "$sums"); then
      say "$name" "CHECKSUM FAILED for $asset against $sums, not deploying"; return 1
    fi
    say "$name" "checksum ok, uploading"
    ninja_deploy "$service" upload "$tag" <"$dir/$asset" | tee -a "$LOG_DIR/ngf-host.log" \
      || { say "$name" "UPLOAD FAILED"; return 1; }
  fi

  if (( dry )); then
    echo "    would run: ninja-deploy $service activate $tag"; return 0
  fi
  if ninja_deploy "$service" activate "$tag" 2>&1 | tee -a "$LOG_DIR/ngf-host.log"; then
    say "$name" "ok, $tag is live"
  else
    say "$name" "DEPLOY FAILED (ninja-deploy rolls back by itself; see above)"; return 1
  fi
}

gh_download() {
  local -a hdr=(-H "Accept: application/octet-stream")
  [[ -r "$TOKEN_FILE" ]] && hdr+=(-H "Authorization: Bearer $(<"$TOKEN_FILE")")
  curl -fsSL "${hdr[@]}" -o "$2" "$1"
}

# --- update: GitHub release projects -------------------------------------------
update_release() {
  local name=$1 repo=${2#gh:} asset=$3 unit=$4 dest=$5

  local json tag url installed_file installed
  if ! json=$(gh_api "https://api.github.com/repos/$repo/releases/latest"); then
    say "$name" "could not fetch latest release for $repo (private repo without token? no releases yet?)"; return 1
  fi
  tag=$(jq -r .tag_name <<<"$json")
  url=$(jq -r --arg a "$asset" '.assets[] | select(.name==$a) | .url' <<<"$json")
  if [[ -z "$url" || "$url" == null ]]; then
    say "$name" "release $tag has no asset named '$asset'. Assets: $(jq -r '[.assets[].name]|join(", ")' <<<"$json")"
    return 1
  fi

  installed_file="$LOG_DIR/$name.tag"
  installed=$(cat "$installed_file" 2>/dev/null || echo none)
  if [[ "$installed" == "$tag" && $force -eq 0 ]]; then
    say "$name" "up to date ($tag)"; return 3
  fi

  say "$name" "updating $installed -> $tag"
  local tmp="$TMP_DIR/$name"
  if (( dry )); then
    echo "    would download $asset from $tag to $tmp"
    echo "    would run: sudo install -m 755 $tmp $dest"
  else
    local -a hdr=(-H "Accept: application/octet-stream")
    [[ -r "$TOKEN_FILE" ]] && hdr+=(-H "Authorization: Bearer $(<"$TOKEN_FILE")")
    local dl="$TMP_DIR/$name.download"
    if ! curl -fsSL "${hdr[@]}" -o "$dl" "$url"; then
      say "$name" "download failed"; return 1
    fi

    # verify against SHA256SUMS if the release ships one
    local sums_url
    sums_url=$(jq -r '.assets[] | select(.name=="SHA256SUMS") | .url' <<<"$json")
    if [[ -n "$sums_url" && "$sums_url" != null ]]; then
      local expected actual
      expected=$(curl -fsSL "${hdr[@]}" "$sums_url" | awk -v a="$asset" '$2==a || $2=="*"a {print $1}')
      actual=$(sha256sum "$dl" | awk '{print $1}')
      if [[ -z "$expected" ]]; then
        say "$name" "warning: $asset not listed in SHA256SUMS, skipping verification"
      elif [[ "$expected" != "$actual" ]]; then
        say "$name" "CHECKSUM MISMATCH for $asset — not installing"; rm -f "$dl"; return 1
      else
        say "$name" "checksum ok"
      fi
    fi

    # archives: extract and find the binary inside
    case "$asset" in
      *.tar.gz|*.tgz)
        local ex="$TMP_DIR/$name.extract"; rm -rf "$ex"; mkdir -p "$ex"
        tar -xzf "$dl" -C "$ex"
        local bin
        bin=$(find "$ex" -type f \( -name "$name" -o -perm -u+x \) | grep -v '\.\(md\|txt\|toml\|yaml\|yml\|json\|service\)$' | head -n 1)
        if [[ -z "$bin" ]]; then
          say "$name" "no binary found inside $asset. Contents: $(find "$ex" -type f -printf '%P ' )"; return 1
        fi
        mv "$bin" "$tmp"; rm -rf "$ex" "$dl" ;;
      *)
        mv "$dl" "$tmp" ;;
    esac
    chmod 755 "$tmp"
    # sanity check: it must at least run --version/--help without crashing
    if ! "$tmp" --version >/dev/null 2>&1 && ! "$tmp" --help >/dev/null 2>&1; then
      say "$name" "downloaded binary won't execute (wrong arch? not a binary?)"; return 1
    fi
    sudo install -m 755 "$tmp" "$dest"
    rm -f "$tmp"
  fi

  restart_unit "$name" "$unit" || return 1
  (( dry )) || echo "$tag" >"$installed_file"
}

# --- main ----------------------------------------------------------------------
if [[ $cmd == status ]]; then
  show PROJECT RUNNING LATEST STATE
  while IFS='|' read -r name f2 f3 f4 f5 f6; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    wanted "$name" || continue
    case "$f2" in
      deploy:*) status_deploy  "$name" "$f2" "$f3" "$f4" ;;
      gh:*)     status_release "$name" "$f2" ;;
      *)        status_git     "$name" "$f2" "$f3" "$f4" "$f5" "$f6" ;;
    esac
  done < "$CONF"
  exit 0
fi

# don't let two updates overlap (e.g. timer + manual)
exec 9>"$LOCK"
flock -n 9 || { echo "another ngf-host update is running" >&2; exit 1; }

updated=() skipped=() failed=()
while IFS='|' read -r name f2 f3 f4 f5 f6; do
  [[ -z "$name" || "$name" == \#* ]] && continue
  wanted "$name" || continue

  if [[ -n $want_version && "$f2" != deploy:* ]]; then
    say "$name" "--version works for deploy: projects only"; failed+=("$name"); continue
  fi
  rc=0
  if [[ "$f2" == deploy:* ]]; then
    ( update_deploy "$name" "$f2" "$f3" "$f4" "$f5" ) || rc=$?
  elif [[ "$f2" == gh:* ]]; then
    ( update_release "$name" "$f2" "$f3" "$f4" "$f5" ) || rc=$?
  else
    ( update_git "$name" "$f2" "$f3" "$f4" "$f5" "$f6" ) || rc=$?
  fi
  case $rc in
    0) updated+=("$name") ;;
    3) skipped+=("$name") ;;
    *) failed+=("$name") ;;
  esac
done < "$CONF"

echo
echo "updated: ${updated[*]:-none}"
echo "skipped: ${skipped[*]:-none}"
(( ${#failed[@]} )) && { echo "FAILED:  ${failed[*]}"; exit 1; }
exit 0
